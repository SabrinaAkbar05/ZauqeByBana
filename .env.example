# Firebase Console > Project settings > General > Your apps > Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Firebase Console > Project settings > Service accounts > Generate new private key
# PRIVATE SERVER ONLY! Never add NEXT_PUBLIC_ to these entries.
FIREBASE_PROJECT_ID=YOUR_PROJECT
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@YOUR_PROJECT.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_KEY\n-----END PRIVATE KEY-----\n"

# Used by the one-time setup command; NEVER commit your actual password
# OWNER_EMAIL=owner@company.com
# OWNER_PASSWORD=UseAnUnpredictablePasswordAtLeast12Characters
# OWNER_NAME=Business Owner
